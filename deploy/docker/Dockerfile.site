# trqsh marketing site (web/site — Next.js 15, pnpm). Build context = repo root:
#   docker build -f deploy/docker/Dockerfile.site -t trqsh/site .
#
# Produces a self-contained Next.js standalone server on a slim Node runtime.

# --- deps ---
FROM node:22-alpine AS deps
WORKDIR /app
RUN npm install -g pnpm@9
COPY web/site/package.json web/site/pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

# --- build ---
FROM node:22-alpine AS build
WORKDIR /app
RUN npm install -g pnpm@9
COPY --from=deps /app/node_modules ./node_modules
COPY web/site ./
# Markdown must exist while Next pre-renders the documentation routes.
COPY docs/content ./content
ARG TRQSH_DASHBOARD_URL=https://app.trqsh.uz
ARG TRQSH_API_URL=https://api.trqsh.uz
ARG TRQSH_SITE_URL=https://trqsh.uz
ARG TRQSH_DASHBOARD_INTERNAL_URL=
ARG TRQSH_API_INTERNAL_URL=
ENV NEXT_TELEMETRY_DISABLED=1 \
    TRQSH_DOCS_CONTENT_DIR=/app/content \
    TRQSH_DASHBOARD_URL=$TRQSH_DASHBOARD_URL \
    TRQSH_API_URL=$TRQSH_API_URL \
    TRQSH_SITE_URL=$TRQSH_SITE_URL \
    TRQSH_DASHBOARD_INTERNAL_URL=$TRQSH_DASHBOARD_INTERNAL_URL \
    TRQSH_API_INTERNAL_URL=$TRQSH_API_INTERNAL_URL
RUN pnpm build

# --- runtime ---
FROM node:22-alpine AS runtime
WORKDIR /app
ENV NODE_ENV=production \
    TRQSH_DOCS_CONTENT_DIR=/app/content \
    PORT=3000 \
    HOSTNAME=0.0.0.0
RUN addgroup -S nodejs -g 1001 && adduser -S nextjs -u 1001 -G nodejs
# Standalone bundle + static assets + public files.
COPY --from=build --chown=nextjs:nodejs /app/.next/standalone ./
COPY --from=build --chown=nextjs:nodejs /app/.next/static ./.next/static
COPY --from=build --chown=nextjs:nodejs /app/public ./public
COPY --from=build --chown=nextjs:nodejs /app/content ./content
USER nextjs
EXPOSE 3000
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD wget -q --spider http://127.0.0.1:3000/ || exit 1
CMD ["node", "server.js"]
