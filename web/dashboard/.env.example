TRQSH_ENV=development

# Public control-plane API origin (Part 05 trqshapi), inlined at build time.
TRQSH_API_URL=http://localhost:8080

# Optional runtime URL for server-side requests (Docker DNS, internal API LB).
# Leave unset for native local development; Compose sets it to http://api:8080.
# TRQSH_API_INTERNAL_URL=http://api:8080

# Public base domain, for building tunnel URLs shown in the UI.
NEXT_PUBLIC_TRQSH_BASE_DOMAIN=lvh.me

# Optional mount path; Cloudflare Compose builds this as /dashboard.
NEXT_PUBLIC_TRQSH_DASHBOARD_BASE_PATH=
