# Keep Docker build contexts small and reproducible.
.git
.github
docs/*
!docs/content
!docs/content/**
plan
deploy/terraform
deploy/helm
deploy/observability

# Node / frontend build artifacts (installed fresh inside the image).
**/node_modules
**/.next
**/dist
/bin
/data

# Local env & editor cruft.
**/.env
**/.env.*
!**/.env.example
.vscode
*.log
